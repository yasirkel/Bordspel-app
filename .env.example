# Copy to .env on the EC2 host. Never commit the real file.
MSSQL_SA_PASSWORD=ChangeThisToAUniqueStrongPassword1!
DomainConnection=Server=sqlserver,1433;Database=BordspelDomain;User Id=sa;Password=ChangeThisToAUniqueStrongPassword1!;TrustServerCertificate=True;MultipleActiveResultSets=True
IdentityConnection=Server=sqlserver,1433;Database=BordspelIdentity;User Id=sa;Password=ChangeThisToAUniqueStrongPassword1!;TrustServerCertificate=True;MultipleActiveResultSets=True
WEB_HOSTNAME=web.203.0.113.10.sslip.io
API_HOSTNAME=api.203.0.113.10.sslip.io
# Set these on the EC2 host or through the deployment environment.
WEBAPP_IMAGE=bordspelapp-webapp:local
API_IMAGE=bordspelapp-api:local
MIGRATOR_IMAGE=bordspelapp-migrator:local
