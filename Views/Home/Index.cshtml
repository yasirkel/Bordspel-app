@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center banner">
    <h1 class="">Welkom bij onze spel avond applicatie</h1>
    <p class="pb-4">Organiseer, deel, en speel samen met je familie en of vrienden, voeg bordspellen toe, en maak spel avonden.</p>

    <div class="header-buttons d-flex gap-3 justify-content-center">
        <div class="bordspellen-button">
            <a class="purple-button" asp-area="" asp-controller="Home" asp-action="Bordspellen">Bordspellen</a>
    </div>
        <div class="bordspellen-button ">
            <a class="green-button" asp-area="" asp-controller="Home" asp-action="Spelavonden">Spelavonden</a>
        </div>
    </div>
</div>

<div class="spelavonden-section">
    <h2 class="pb-5">Recente spelavonden</h2>
    
    <div class="spelavond-cards-wrapper">
        <div class="spelavond-card d-flex justify-content-between align-items-center mb-3">

            <div class="spelavond-col1">
                <h3 class="pb-2">Domino</h3>
                <p class="w-50">Ontdek onze geweldige collectie bordspellen en beleef eindeloos speelplezier met familie en vrienden! 🎲✨</p>
                <p>Gemaakt door: <b>Yasir kel</b></p>
            </div>

            <div class="spelavond-col2">
                <h3 class="me-0">12:48</h3>
                <p class="me-0">30-10-2024</p>
                <button class="purple-button">Inschrijven</button>
            </div>

        </div>

        <div class="spelavond-card d-flex justify-content-between align-items-center">

            <div class="spelavond-col1">
                <h3 class="pb-2">Uno card game</h3>
                <p class="w-50">UNO is een kaartspel waarbij je kaarten moet afleggen op basis van kleur of nummer. Speciale kaarten zorgen voor extra spanning. Roep "UNO!" bij je laatste kaart en speel als eerste alles weg om te winnen! 🎉</p>
                <p>Gemaakt door: <b>Yasir kel</b></p>
            </div>

            <div class="spelavond-col2">
                <h3 class="me-0">14:18</h3>
                <p class="me-0">31-10-2024</p>
                <button class="purple-button">Inschrijven</button>
            </div>

        </div>
    </div>
</div>

