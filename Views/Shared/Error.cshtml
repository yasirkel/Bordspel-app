@model ErrorViewModel
@{
    ViewData["Title"] = "Er is iets misgegaan";
}

<h1 class="text-danger">Er is iets misgegaan.</h1>
<h2 class="text-danger">De pagina kon niet worden verwerkt.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Referentienummer:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Probeer het later opnieuw. Neem contact op met de beheerder als het probleem blijft bestaan.</p>
