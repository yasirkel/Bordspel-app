@{
    ViewData["Title"] = "Bordspellen";
}

<div class="container bordspellen-banner">
    <h1 class="w-50">ZIE AL ONZE GEWELDIGE BORDSPELLEN</h1>
    <p class="mb-5 w-50">Ontdek onze geweldige collectie bordspellen en beleef eindeloos speelplezier met familie en vrienden!</p>
    <a class="purple-button" asp-area="" asp-controller="Home" asp-action="Spelavonden">Bord spel avonden</a>
</div>

<div class="button-container">
    <div class="error-message" id="error-message">Kan geen spellen toevoegen, probeer het later opnieuw...</div>
    <button class="green-button mb-4" onclick="showError()">Spel toevoegen +</button>
</div>

