@model BordspelApp.WebApp.Models.BoardGameListViewModel

@{
    ViewData["Title"] = "Bordspellen";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-dice-d20 text-primary"></i> Bordspellen
        </h1>
    </div>

    @if (!Model.BoardGames.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Er zijn momenteel geen bordspellen beschikbaar.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var boardGame in Model.BoardGames)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(boardGame.ImageUrl))
                        {
                            <img src="@boardGame.ImageUrl" class="card-img-top" alt="@boardGame.Name" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 250px;">
                                <i class="fas fa-dice-d20 fa-5x text-white-50"></i>
                            </div>
                        }
                        
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                @boardGame.Name
                                @if (boardGame.Is18Plus)
                                {
                                    <span class="badge bg-danger ms-2">18+</span>
                                }
                            </h5>
                            
                            <div class="mt-auto">
                                <ul class="list-unstyled mb-3">
                                    <li>
                                        <i class="fas fa-layer-group text-primary"></i>
                                        <strong>Genre:</strong> @boardGame.Genre
                                    </li>
                                    <li>
                                        <i class="fas fa-gamepad text-primary"></i>
                                        <strong>Type:</strong> @boardGame.Type
                                    </li>
                                </ul>
                                
                                <a asp-action="Details" asp-route-id="@boardGame.Id" class="btn btn-primary w-100">
                                    <i class="fas fa-info-circle"></i> Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
