@model BordspelApp.WebApp.Models.BoardGameDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Bordspellen</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name">
            }
            else
            {
                <div class="bg-secondary rounded shadow d-flex align-items-center justify-content-center" style="height: 400px;">
                    <i class="fas fa-dice-d20 fa-5x text-white-50"></i>
                </div>
            }
        </div>

        <div class="col-md-8">
            <h1>
                @Model.Name
                @if (Model.Is18Plus)
                {
                    <span class="badge bg-danger ms-2">18+</span>
                }
            </h1>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-info-circle text-primary"></i> Informatie</h5>
                    
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="card-text">@Model.Description</p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic">Geen beschrijving beschikbaar.</p>
                    }

                    <hr>

                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2">
                                <i class="fas fa-layer-group text-primary"></i>
                                <strong>Genre:</strong> @Model.Genre
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2">
                                <i class="fas fa-gamepad text-primary"></i>
                                <strong>Type:</strong> @Model.Type
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-calendar-alt text-primary"></i> Aankomende Spelavonden
                    </h5>

                    @if (Model.UpcomingGameNights.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var gameNight in Model.UpcomingGameNights)
                            {
                                <a asp-controller="GameNights" asp-action="Details" asp-route-id="@gameNight.Id" 
                                   class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1">@gameNight.Title</h6>
                                            <small class="text-muted">
                                                <i class="fas fa-map-marker-alt"></i> @gameNight.City
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted">
                                                <i class="fas fa-clock"></i> @gameNight.StartAt.ToString("dd MMM yyyy HH:mm")
                                            </small>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle"></i> Dit bordspel wordt momenteel niet gespeeld op aankomende spelavonden.
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Terug naar overzicht
                </a>
            </div>
        </div>
    </div>
</div>
