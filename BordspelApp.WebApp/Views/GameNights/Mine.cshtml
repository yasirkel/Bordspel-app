@model BordspelApp.WebApp.Models.GameNightListViewModel

@{
    ViewData["Title"] = "Mijn Spelavonden";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Mijn Spelavonden</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-calendar-plus me-2"></i>
        @ViewData["Title"]
    </h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus me-2"></i>
        Nieuwe Spelavond
    </a>
</div>

@if (!Model.GameNights.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        Je hebt nog geen spelavonden georganiseerd. 
        <a asp-action="Create" class="alert-link">Maak je eerste spelavond aan</a>!
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var gameNight in Model.GameNights)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            @gameNight.Title
                            @if (gameNight.Is18Plus)
                            {
                                <span class="badge bg-warning text-dark ms-2">18+</span>
                            }
                        </h5>
                        <p class="card-text text-muted">
                            <i class="fas fa-calendar-alt me-2"></i>
                            @gameNight.StartAt.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("nl-NL"))
                        </p>
                        <p class="card-text text-muted">
                            <i class="fas fa-clock me-2"></i>
                            @gameNight.StartAt.ToString("HH:mm")
                        </p>
                        <p class="card-text text-muted">
                            <i class="fas fa-map-marker-alt me-2"></i>
                            @gameNight.City
                        </p>
                        <p class="card-text">
                            <i class="fas fa-users me-2"></i>
                            @gameNight.CurrentPlayers van @gameNight.MaxPlayers spelers
                        </p>
                        @if (gameNight.CurrentPlayers >= gameNight.MaxPlayers)
                        {
                            <span class="badge bg-success">Vol</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">@(gameNight.MaxPlayers - gameNight.CurrentPlayers) plaatsen beschikbaar</span>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@gameNight.Id" class="btn btn-sm btn-primary flex-fill">
                                <i class="fas fa-info-circle me-1"></i>
                                Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@gameNight.Id" class="btn btn-sm btn-warning flex-fill">
                                <i class="fas fa-edit me-1"></i>
                                Bewerken
                            </a>
                            <a asp-action="Delete" asp-route-id="@gameNight.Id" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Paginering" class="mt-4">
            <ul class="pagination justify-content-center">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Mine" asp-route-page="@(Model.CurrentPage - 1)">
                            <i class="fas fa-chevron-left"></i> Vorige
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Mine" asp-route-page="@i">@i</a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Mine" asp-route-page="@(Model.CurrentPage + 1)">
                            Volgende <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
