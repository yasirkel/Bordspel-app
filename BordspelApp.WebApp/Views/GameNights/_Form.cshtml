@model BordspelApp.WebApp.Models.GameNightCreateViewModel
<div class="row">
    <div class="col-md-8">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        <div class="mb-3">
            <label asp-for="StartAt" class="form-label"></label>
            <input asp-for="StartAt" class="form-control" type="datetime-local" />
            <span asp-validation-for="StartAt" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MaxPlayers" class="form-label"></label>
            <input asp-for="MaxPlayers" class="form-control" />
            <span asp-validation-for="MaxPlayers" class="text-danger"></span>
        </div>
        <fieldset class="border p-3 mb-3">
            <legend class="w-auto">Adres</legend>
            <div class="row g-2">
                <div class="col-md-6">
                    <label asp-for="Street" class="form-label"></label>
                    <input asp-for="Street" class="form-control" />
                    <span asp-validation-for="Street" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="HouseNumber" class="form-label"></label>
                    <input asp-for="HouseNumber" class="form-control" />
                    <span asp-validation-for="HouseNumber" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="PostalCode" class="form-label"></label>
                    <input asp-for="PostalCode" class="form-control" />
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>
            </div>
        </fieldset>
        <fieldset class="border p-3 mb-3">
            <legend class="w-auto">Opties eten/drinken</legend>
            <div class="form-check">
                <input class="form-check-input" asp-for="HasLactoseFree" />
                <label class="form-check-label" asp-for="HasLactoseFree"></label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="HasNutFree" />
                <label class="form-check-label" asp-for="HasNutFree"></label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="HasVegetarian" />
                <label class="form-check-label" asp-for="HasVegetarian"></label>
            </div>
            <div class="form-check">
                <input class="form-check-input" asp-for="HasAlcoholFree" />
                <label class="form-check-label" asp-for="HasAlcoholFree"></label>
            </div>
        </fieldset>
        <fieldset class="border p-3 mb-3">
            <legend class="w-auto">Kies spellen</legend>
            @foreach (var game in Model.AvailableBoardGames)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedBoardGameIds" value="@game.Id" checked="@(Model.SelectedBoardGameIds.Contains(game.Id))" />
                    <label class="form-check-label">@game.Name (@(game.Is18Plus ? "18+" : "alle leeftijden"))</label>
                </div>
            }
        </fieldset>
    </div>
</div>
