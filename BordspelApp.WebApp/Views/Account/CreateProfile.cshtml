@model BordspelApp.WebApp.Controllers.CreateProfileViewModel
@{
    ViewData["Title"] = "Maak profiel";
}
<h2>@ViewData["Title"]</h2>
<form asp-action="CreateProfile" method="post">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" type="date" class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<BordspelApp.Domain.Enums.Gender>()"></select>
        </div>
        <div class="col-md-6">
            <label asp-for="Street" class="form-label"></label>
            <input asp-for="Street" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="HouseNumber" class="form-label"></label>
            <input asp-for="HouseNumber" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
        </div>
        <div class="col-12">
            <div class="form-check form-check-inline">
                <input class="form-check-input" asp-for="IsLactoseFree" />
                <label class="form-check-label" asp-for="IsLactoseFree"></label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" asp-for="IsNutFree" />
                <label class="form-check-label" asp-for="IsNutFree"></label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" asp-for="IsVegetarian" />
                <label class="form-check-label" asp-for="IsVegetarian"></label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" asp-for="IsAlcoholFree" />
                <label class="form-check-label" asp-for="IsAlcoholFree"></label>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary" type="submit">Opslaan</button>
        <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Annuleren</a>
    </div>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
