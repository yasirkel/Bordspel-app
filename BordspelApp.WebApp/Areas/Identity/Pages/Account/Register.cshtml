@page
@model BordspelApp.WebApp.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-6 mx-auto rounded border p-3">
        <h2 class="text-center mb-3">Register</h2>
        <hr />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @Html.AntiForgeryToken()
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label-sm">First Name</label>
                <div class="col-sm-8">
                    <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" />
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label-sm">Last Name</label>
                <div class="col-sm-8">
                    <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label-sm">Email</label>
                <div class="col-sm-8">
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label-sm">Phone</label>
                <div class="col-sm-8">
                    <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" aria-required="true" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label-sm">Address</label>
                <div class="col-sm-8">
                    <input asp-for="Input.Address" class="form-control" autocomplete="street-address" />
                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label-sm">Date of birth</label>
                <div class="col-sm-8">
                    <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label-sm">Allergies / Dietary</label>
                <div class="col-sm-8">
                    <div class="form-check">
                        <input asp-for="Input.IsLactoseFree" class="form-check-input" type="checkbox" />
                        <label asp-for="Input.IsLactoseFree" class="form-check-label">Lactose free</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Input.IsNutFree" class="form-check-input" type="checkbox" />
                        <label asp-for="Input.IsNutFree" class="form-check-label">Nut free</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Input.IsVegetarian" class="form-check-input" type="checkbox" />
                        <label asp-for="Input.IsVegetarian" class="form-check-label">Vegetarian</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Input.IsAlcoholFree" class="form-check-input" type="checkbox" />
                        <label asp-for="Input.IsAlcoholFree" class="form-check-label">No alcohol</label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label-sm">Password</label>
                <div class="col-sm-8">
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label-sm">Confirm Password</label>
                <div class="col-sm-8">
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary">Register</button>
                </div>
            </div>
        </form>
    </div>
</div>
